# Application Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./gatekeeper.db

# Authentication (OIDC / Keycloak)
# In production, specify external Keycloak/OIDC discovery endpoint:
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/gatekeeper-realm
OIDC_CLIENT_ID=gatekeeper-client
OIDC_AUDIENCE=gatekeeper-client
# Local Demo Mode (binds localhost only; startup strictly REFUSES demo mode when ENVIRONMENT=production)
DEMO_MODE=true
DEMO_JWT_SECRET=local-development-only-secret-do-not-use-in-production

# LLM Advisory Configuration (Optional - offline deterministic gating works without LLM)
# LLM_API_KEY is the only LLM credential variable
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
